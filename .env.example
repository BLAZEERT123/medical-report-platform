# ─────────────────────────────────────────────────────
# Medical Report Intelligence Platform — Environment
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
# ─────────────────────────────────────────────────────

# ── LLM Provider (choose one) ─────────────────────────
# Google Gemini (free tier at aistudio.google.com):
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI (optional alternative):
# OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic Claude (optional alternative):
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── LLM Settings ──────────────────────────────────────
# Provider: gemini | openai | anthropic
LLM_PROVIDER=gemini
# Model name for the chosen provider:
#   Gemini:    gemini-2.5-flash | gemini-1.5-pro
#   OpenAI:    gpt-4o-mini | gpt-4o
#   Anthropic: claude-haiku-20240307 | claude-3-5-sonnet-20241022
LLM_MODEL=gemini-2.5-flash

# ── Embedding Provider ────────────────────────────────
# Options: gemini | openai | local
# 'local' uses all-MiniLM-L6-v2 (no API cost, runs on CPU)
EMBEDDING_PROVIDER=gemini

# ── OCR ───────────────────────────────────────────────
# Confidence threshold (0–100). Below this shows a low-quality warning.
OCR_CONFIDENCE_THRESHOLD=70

# ── Database ──────────────────────────────────────────
SQLITE_DB_PATH=./data/reports.db

# ── Chroma Vector Stores ──────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma
REPORT_COLLECTION=report_chunks
REFERENCE_COLLECTION=reference_corpus

# ── Retrieval ─────────────────────────────────────────
# Number of chunks to retrieve per store for Q&A
RETRIEVAL_TOP_K=3

# ── Backend Server ────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
